NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=<anon-key dari Settings > API>
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Rahasia backend Nuxt/Nitro. Isi hanya pada environment server; jangan commit .env.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key dari Settings > API>
AI_SERVICE_URL=https://<ai-service-url>
AI_SERVICE_KEY=<shared-secret-ai-service>

# Kosongkan saat web dan API Nuxt berada pada origin yang sama.
# Untuk aplikasi Capacitor, isi URL API Nuxt yang telah dideploy.
NUXT_PUBLIC_API_BASE_URL=https://api.<domain-anda>
