# Secret Edge Function di-set lewat: supabase secrets set KEY=VALUE
# File ini untuk skrip lokal (gen types, psql) saja.
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
DATABASE_URL=postgresql://postgres:<pwd>@db.<project-ref>.supabase.co:5432/postgres
AI_SERVICE_URL=https://<ai-service-host>
AI_SERVICE_KEY=<shared-secret>
RESEND_API_KEY=<resend-key>
EMAIL_FROM=noreply@kampus.ac.id
